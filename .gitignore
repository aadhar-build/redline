# ---- Dependencies ----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Next.js / build output ----
.next/
out/
build/
dist/
.turbo/
.swc/
next-env.d.ts
*.tsbuildinfo

# ---- Testing / coverage ----
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# ---- Environment files (never commit) ----
.env
.env.*
!.env.example
.envrc
.dev.vars

# ---- Credentials, keys, certificates ----
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
id_rsa*
id_ed25519*
*.gpg
secrets.json
secrets.*.json
credentials.json
service-account*.json
*-service-account.json
gcp-key*.json
firebase-adminsdk*.json
.npmrc
.yarnrc.yml
.netrc
.htpasswd
auth.json

# ---- Platform / deploy local state (can hold tokens) ----
.vercel/
.netlify/
.firebase/
.supabase/
supabase/.temp/
.sentryclirc
.aws/
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# ---- Local databases and dumps (may contain user data) ----
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz

# ---- User-uploaded documents during local testing ----
uploads/
tmp/

# ---- Logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
*.log

# ---- Editor / OS ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# ---- Local AI tool state ----
.claude/settings.local.json

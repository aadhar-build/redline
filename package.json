{
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "jszip": "3.10.2",
    "next": "^16.3.4",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "name": "redline",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "REDLINE_LOOPBACK_ONLY=1 next dev -H 127.0.0.1 -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:isolation": "vitest run --config vitest.isolation.config.mts",
    "test:e2e": "npm run build && playwright test",
    "check:client-bundle": "node scripts/check-client-bundle.mjs .next",
    "test:bundle-check-plant": "node scripts/prove-bundle-check-fails.mjs",
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "predev:local": "node scripts/copy-pdfjs-assets.mjs",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vitest": "^5.0.5"
  }
}
